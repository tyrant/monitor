[Unit]
Description=Script Monitor Dashboard
After=network.target

[Service]
Type=simple
User=noob
WorkingDirectory=/home/noob/monitor
EnvironmentFile=/home/noob/monitor/.env
ExecStart=/home/noob/monitor/venv/bin/gunicorn -w 1 -b 127.0.0.1:5001 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
